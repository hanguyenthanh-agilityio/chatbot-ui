{
  "name": "ai-sdk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "pnpm run dev:all",
    "dev:web": "next dev",
    "dev:ollama": "sh -c \"curl -sSf http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && echo 'Ollama already running on 127.0.0.1:11434' || ollama serve\"",
    "dev:mcp": "node scripts/mcp-demo-server.mjs",
    "dev:all": "sh -c \"pnpm run dev:web & pnpm run dev:ollama & pnpm run dev:mcp & wait\"",
    "dev:mock-production": "NEXT_PUBLIC_MOCK_PRODUCTION=true pnpm run dev:all",
    "ollama:pull": "ollama pull qwen2.5:3b",
    "ollama:pull:vision": "ollama pull gemma3:4b",
    "tunnel:ollama": "cloudflared tunnel --url http://127.0.0.1:11434 --http-host-header 127.0.0.1:11434",
    "tunnel:mcp": "cloudflared tunnel --url http://127.0.0.1:4001 --http-host-header 127.0.0.1:4001",
    "mcp:demo": "node scripts/mcp-demo-server.mjs",
    "mcp:demo:stdio": "node scripts/mcp-demo-server-stdio.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.25",
    "@ai-sdk/openai": "^3.0.27",
    "@ai-sdk/react": "^3.0.83",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ai": "^6.0.81",
    "mammoth": "^1.11.0",
    "next": "16.1.6",
    "pdf-parse": "^2.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
