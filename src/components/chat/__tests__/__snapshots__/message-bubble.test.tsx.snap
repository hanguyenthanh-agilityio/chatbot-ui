// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MessageAvatar > matches snapshot (assistant) 1`] = `"<div role="img" aria-label="Employee Assistant avatar" class="relative shrink-0 select-none overflow-hidden rounded-full bg-cover bg-center size-avatar-sm border border-white/20 shadow-avatar-brand light:border-app-border-10 mt-1" style="background-image: url(/chatbot-assistant-avatar.png), var(--avatar-assistant-fallback);"></div>"`;

exports[`MessageAvatar > matches snapshot (user-initials) 1`] = `"<div role="img" aria-label="Ha Nguyen avatar" class="relative shrink-0 select-none overflow-hidden rounded-full bg-cover bg-center size-avatar-sm bg-avatar-user-placeholder ring-[1.5px] ring-indigo-400/35 light:ring-stone-400/50 shadow-avatar-placeholder mt-1"><span class="absolute inset-0 flex items-center justify-center font-semibold text-white/90 light:text-white text-compact-10 tracking-wide">HN</span></div>"`;

exports[`MessageAvatar > matches snapshot (user-with-url) 1`] = `"<div role="img" aria-label="Ha Nguyen avatar" class="relative shrink-0 select-none overflow-hidden rounded-full bg-cover bg-center h-9 w-9 bg-avatar-user-placeholder ring-[1.5px] ring-indigo-400/35 light:ring-stone-400/50 shadow-avatar-photo mt-1" style="background-image: url(&quot;https://example.com/user.png&quot;);"></div>"`;

exports[`MessageBubble > matches snapshot (assistant) 1`] = `"<div class="rounded-2xl border px-4 py-2.5 text-sm leading-relaxed shadow-bubble-assistant backdrop-blur-md border-white/11 bg-bubble-assistant text-white/88 light:border-app-border-10 light:text-app-fg light:backdrop-blur-none max-w-bubble-assistant"><span class="whitespace-pre-wrap">You have 12 annual days remaining.</span></div>"`;

exports[`MessageBubble > matches snapshot (assistant-full-width) 1`] = `"<div class="rounded-2xl border px-4 py-2.5 text-sm leading-relaxed shadow-bubble-assistant backdrop-blur-md border-white/11 bg-bubble-assistant text-white/88 light:border-app-border-10 light:text-app-fg light:backdrop-blur-none max-w-full"><span class="whitespace-pre-wrap">Wide content</span></div>"`;

exports[`MessageBubble > matches snapshot (assistant-placeholder) 1`] = `"<div class="rounded-2xl border px-4 py-2.5 text-sm leading-relaxed shadow-bubble-assistant backdrop-blur-md border-white/11 bg-bubble-assistant text-white/88 light:border-app-border-10 light:text-app-fg light:backdrop-blur-none max-w-bubble-assistant"><span class="text-white/40 light:text-app-muted-50">Working on it...</span></div>"`;

exports[`MessageBubble > matches snapshot (assistant-with-children) 1`] = `"<div class="rounded-2xl border px-4 py-2.5 text-sm leading-relaxed shadow-bubble-assistant backdrop-blur-md border-white/11 bg-bubble-assistant text-white/88 light:border-app-border-10 light:text-app-fg light:backdrop-blur-none max-w-bubble-assistant"><span class="whitespace-pre-wrap">Summary</span><div class="mt-3"><p class="text-sm">Nested table area</p></div></div>"`;

exports[`MessageBubble > matches snapshot (user) 1`] = `"<div class="ml-auto max-w-bubble-user rounded-bubble-user border px-3.75 py-2.5 text-sm leading-relaxed wrap-break-word shadow-bubble-user backdrop-blur-lg border-violet-300/28 bg-bubble-user text-white/90 light:border-stone-600/20 light:text-white/95 light:backdrop-blur-none"><span class="whitespace-pre-wrap">How many leave days do I have left?</span></div>"`;
