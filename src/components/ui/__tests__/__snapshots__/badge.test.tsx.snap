exports[`Badge > matches snapshot (brand) 1`] = `"<span class="inline-flex rounded-full border font-medium app-badge-brand border-violet-400/35 bg-violet-500/16 text-violet-200 light:border-amber-300/70 light:bg-amber-50 light:text-amber-950 px-2.5 py-0.5 text-[11px]">Review first</span>"`;

exports[`Badge > matches snapshot (custom-class) 1`] = `"<span class="inline-flex rounded-full border font-medium app-badge-success border-emerald-400/35 bg-emerald-500/15 text-emerald-100 light:border-emerald-300/70 light:bg-emerald-100 light:text-emerald-900 px-2.5 py-0.5 text-[11px] uppercase tracking-wide">OK</span>"`;

exports[`Badge > matches snapshot (default) 1`] = `"<span class="inline-flex rounded-full border font-medium app-badge-neutral border-white/20 bg-white/8 text-white/80 light:border-app-border-10 light:bg-app-surface-6 light:text-app-fg-muted px-2.5 py-0.5 text-[11px]">Default</span>"`;

exports[`Badge > matches snapshot (providerOllama) 1`] = `"<span class="inline-flex rounded-full border font-medium app-badge-provider-ollama border-violet-400/35 bg-violet-500/16 text-violet-200 light:border-stone-300/80 light:bg-stone-100 light:text-stone-800 px-2.5 py-0.5 text-[11px]">ollama</span>"`;

exports[`Badge > matches snapshot (sm-info) 1`] = `"<span class="inline-flex rounded-full border font-medium app-badge-info border-cyan-400/30 bg-cyan-500/14 text-cyan-100 light:border-cyan-300/70 light:bg-cyan-100 light:text-cyan-900 px-2 py-0.5 text-[10px]">Small</span>"`;
