// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Text > matches snapshot (as-h2) 1`] = `"<h2 class="font-primary text-2xl font-bold text-white light:text-app-fg">Heading</h2>"`;

exports[`Text > matches snapshot (body) 1`] = `"<p class="font-secondary text-sm text-white/80 light:text-app-fg-muted">Sample</p>"`;

exports[`Text > matches snapshot (bodyStrong) 1`] = `"<p class="font-secondary text-sm font-medium text-white/80 light:text-app-fg-muted">Sample</p>"`;

exports[`Text > matches snapshot (caption) 1`] = `"<p class="font-secondary text-xs text-white/60 light:text-app-fg-subtle">Sample</p>"`;

exports[`Text > matches snapshot (captionMuted) 1`] = `"<p class="font-secondary text-xs text-white/55 light:text-app-fg-tertiary">Sample</p>"`;

exports[`Text > matches snapshot (captionStrong) 1`] = `"<p class="font-secondary text-xs text-white/65 light:text-app-fg-quaternary">Sample</p>"`;

exports[`Text > matches snapshot (custom-class) 1`] = `"<p class="font-secondary text-sm text-white/80 light:text-app-fg-muted text-center uppercase">Styled</p>"`;

exports[`Text > matches snapshot (display) 1`] = `"<p class="font-primary text-3xl font-bold tracking-tight text-white light:text-app-fg">Sample</p>"`;

exports[`Text > matches snapshot (error) 1`] = `"<p class="text-sm text-red-400 light:text-app-danger-fg">Sample</p>"`;

exports[`Text > matches snapshot (eyebrow) 1`] = `"<p class="font-primary text-xs font-semibold uppercase tracking-[0.2em] text-white/55 light:text-app-fg-tertiary">Sample</p>"`;

exports[`Text > matches snapshot (eyebrowMuted) 1`] = `"<p class="font-primary text-xs font-semibold uppercase tracking-[0.2em] text-white/50 light:text-app-fg-faint">Sample</p>"`;

exports[`Text > matches snapshot (helper) 1`] = `"<p class="font-secondary text-compact-11 text-white/50 light:text-app-fg-faint">Sample</p>"`;

exports[`Text > matches snapshot (inherit) 1`] = `"<p class="text-sm text-inherit">Sample</p>"`;

exports[`Text > matches snapshot (muted) 1`] = `"<p class="font-secondary text-sm text-white/65 light:text-app-fg-quaternary">Sample</p>"`;

exports[`Text > matches snapshot (sectionTitle) 1`] = `"<p class="font-primary text-sm font-semibold text-white/80 light:text-app-fg-muted">Sample</p>"`;

exports[`Text > matches snapshot (subtitle) 1`] = `"<p class="font-secondary text-[15px] leading-7 text-white/70 light:text-app-fg-muted">Sample</p>"`;

exports[`Text > matches snapshot (title) 1`] = `"<p class="font-primary text-2xl font-bold text-white light:text-app-fg">Sample</p>"`;

exports[`Text > matches snapshot (warning) 1`] = `"<p class="text-xs text-amber-400 light:text-app-warning-fg">Sample</p>"`;
