// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Toast > snapshot error > error 1`] = `"<div role="status" aria-live="polite" class="flex max-w-sm items-center gap-3 rounded-2xl border px-4 py-3 font-secondary backdrop-blur-xl transition-all duration-280 fixed right-5 top-5 z-[9999] border border-rose-400/28 bg-rose-500/12 text-rose-200 shadow-toast-error light:border-app-danger-border light:bg-app-danger-bg light:text-app-danger-fg light:shadow-panel-sm translate-y-0 opacity-100"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-semibold bg-rose-500/25 text-rose-200 light:bg-app-danger-bg light:text-app-danger-fg">✕</span><span class="text-sm font-medium leading-snug">Action completed successfully</span><button type="button" class="ml-auto shrink-0 cursor-pointer rounded-lg p-1 opacity-60 transition hover:bg-white/10 hover:opacity-100 light:hover:bg-app-hover" aria-label="Dismiss">✕</button></div>"`;

exports[`Toast > snapshot info > info 1`] = `"<div role="status" aria-live="polite" class="flex max-w-sm items-center gap-3 rounded-2xl border px-4 py-3 font-secondary backdrop-blur-xl transition-all duration-280 fixed right-5 top-5 z-[9999] border border-cyan-400/28 bg-cyan-500/12 text-cyan-100 shadow-toast-info light:border-app-info-border light:bg-app-info-bg light:text-app-info-fg light:shadow-panel-sm translate-y-0 opacity-100"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-semibold bg-cyan-500/25 text-cyan-200 light:bg-app-info-bg light:text-app-info-fg">ℹ</span><span class="text-sm font-medium leading-snug">Action completed successfully</span><button type="button" class="ml-auto shrink-0 cursor-pointer rounded-lg p-1 opacity-60 transition hover:bg-white/10 hover:opacity-100 light:hover:bg-app-hover" aria-label="Dismiss">✕</button></div>"`;

exports[`Toast > snapshot success > success 1`] = `"<div role="status" aria-live="polite" class="flex max-w-sm items-center gap-3 rounded-2xl border px-4 py-3 font-secondary backdrop-blur-xl transition-all duration-280 fixed right-5 top-5 z-[9999] border border-emerald-400/28 bg-emerald-500/12 text-emerald-100 shadow-toast-success light:border-app-success-border light:bg-app-success-bg light:text-app-success-fg light:shadow-panel-sm translate-y-0 opacity-100"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-semibold bg-emerald-500/25 text-emerald-200 light:bg-app-success-bg light:text-app-success-fg">✓</span><span class="text-sm font-medium leading-snug">Action completed successfully</span><button type="button" class="ml-auto shrink-0 cursor-pointer rounded-lg p-1 opacity-60 transition hover:bg-white/10 hover:opacity-100 light:hover:bg-app-hover" aria-label="Dismiss">✕</button></div>"`;
